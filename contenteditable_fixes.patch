## 3. JS — Исправление утечки памяти (бесконечный цикл)

В начале IIFE (примерно строка 200), после объявления переменных, ДОБАВЬТЕ:

```js
var isRendering = {}; // flags to prevent recursion
```

ЗАМЕНИТЕ функцию handle (примерно строка 287):

```js
function handle(el){
  return function(){
    // Protection from recursion
    if (isRendering[el.id]) return;
    isRendering[el.id] = true;

    clearErrors();
    
    var baseRadix = radixOf(el);
    var raw = renderWithSubscripts(el, baseRadix);

    if (raw.trim() === ''){
      [dec,bin,hex,cust].forEach(function(f){ 
        if(f !== el) f.textContent = ''; 
      });
      resetTimer(el);
      isRendering[el.id] = false;
      return;
    }

    var r = baseRadix;
    if (el === cust && (r < 2 || r > 36)){ 
      el.classList.add('error'); 
      isRendering[el.id] = false;
      return; 
    }

    var value = evalExpr(raw, r);
    if (value === null){
      isRendering[el.id] = false;
      return;
    }
    if (typeof value !== 'bigint'){ 
      el.classList.add('error'); 
      isRendering[el.id] = false;
      return; 
    }

    updateAll(value, el);
    resetTimer(el);
    isRendering[el.id] = false;
  };
}
```

ЗАМЕНИТЕ функцию updateAll (примерно строка 272):

```js
function updateAll(value, except){
  var b = getBase();
  
  // Block rendering for all fields except source
  [dec,bin,hex,cust].forEach(function(f){ 
    if (f !== except) isRendering[f.id] = true; 
  });

  if (except !== dec){
    dec.textContent = bigToString(value, 10);
    renderWithSubscripts(dec, 10);
  }
  if (except !== bin){
    bin.textContent = bigToString(value, 2);
    renderWithSubscripts(bin, 2);
  }
  if (except !== hex){
    hex.textContent = bigToString(value, 16).toUpperCase();
    renderWithSubscripts(hex, 16);
  }
  if (except !== cust){
    cust.textContent = bigToString(value, b).toUpperCase();
    renderWithSubscripts(cust, b);
  }

  [dec,bin,hex,cust].forEach(function(f){
    if (f !== except){
      markCommitted(f, value);
      isRendering[f.id] = false;
    }
  });
}
```

