## 2. JS — Исправление tokenizeExpression (subscript всегда показывал ₂)

Найдите функцию tokenizeExpression (примерно строка 257) и ЗАМЕНИТЕ её полностью:

```js
function tokenizeExpression(text, defaultBase){
  var tokens = [];
  var i = 0;

  while (i < text.length){
    var ch = text[i];

    // Operators and spaces
    if (/[\s+\-*/()]/.test(ch)){
      tokens.push({type:'operator', text:ch});
      i++;
      continue;
    }

    // Number
    var numStart = i;
    var detectedBase = null;

    // Prefix 0x
    if (text[i] === '0' && (text[i+1] === 'x' || text[i+1] === 'X')){
      detectedBase = 16;
      i += 2;
      while (i < text.length && /[0-9a-fA-F]/.test(text[i])) i++;
    }
    // Prefix 0b
    else if (text[i] === '0' && (text[i+1] === 'b' || text[i+1] === 'B')){
      detectedBase = 2;
      i += 2;
      while (i < text.length && /[01]/.test(text[i])) i++;
    }
    // Bare number — use field's base
    else {
      detectedBase = defaultBase;
      // Read all characters valid for this base
      var validChars = DIGITS.slice(0, defaultBase);
      while (i < text.length && validChars.indexOf(text[i].toLowerCase()) !== -1){
        i++;
      }
    }

    var numText = text.slice(numStart, i);
    if (numText.length > 0){
      tokens.push({type:'number', text:numText, base:detectedBase});
    }
  }

  return tokens;
}
```

И обновите renderWithSubscripts (примерно строка 240) — добавьте передачу baseRadix:

```js
function renderWithSubscripts(el, baseRadix){
  var cursorPos = saveCursorPosition(el);
  var text = getPlainText(el);

  if (text.trim() === ''){
    el.textContent = '';
    return text;
  }

  var tokens = tokenizeExpression(text, baseRadix); // <-- передать baseRadix
  var html = '';

  tokens.forEach(function(token){
    if (token.type === 'number'){
      var subscript = toSubscript(token.base);
      var escaped = escapeHtml(token.text);
      html += escaped + '<sub>' + subscript + '</sub>';
    } else {
      html += escapeHtml(token.text);
    }
  });

  el.innerHTML = html;
  restoreCursorPosition(el, cursorPos);
  return text;
}
```

